[sub_resource type="GDScript" id="GDScript_651ht"]
script/source = "extends Node3D
## Open DrinkDispenserTest.tscn and press F6 to try the dispenser manually.

@onready var player: Player = $Player
@onready var instructions: Label = $TestHud/Instructions


func _ready() -> void:
	RunManager.start_new_run(true, 123)
	RunManager.current_run.add_coins(500)
	RunManager.current_run.coins_updated.connect(_update_instructions)
	$RestaurantUi/DrinkMenu.visibility_changed.connect(_update_hud_visibility)
	$PauseMenu.visibility_changed.connect(_update_hud_visibility)
	_update_instructions(RunManager.current_run.coins)


func _unhandled_key_input(event: InputEvent) -> void:
	if not event.is_pressed() or event.is_echo():
		return
	if event.keycode == KEY_R:
		RunManager.current_run.add_coins(500 - RunManager.current_run.coins)
		get_viewport().set_input_as_handled()
	elif event.keycode == KEY_X:
		_discard_drink()
		get_viewport().set_input_as_handled()


func _discard_drink() -> void:
	if is_instance_valid(player.held_edible):
		player._release_held_edible().queue_free()


func _update_hud_visibility() -> void:
	$TestHud.visible = not $RestaurantUi/DrinkMenu.visible and not $PauseMenu.visible


func _update_instructions(coins: float) -> void:
	instructions.text = (
		\"DRINK DISPENSER TEST — Coins: %s\\n\" % str(coins)
		+ \"WASD: move | Mouse: look | Right-click / F: open drink menu\\n\"
		+ \"Buy a drink or close the menu, then check mouse look.\\n\"
		+ \"X: discard held drink | R: restore 500 coins | Esc: close menu / pause\"
	)


func _exit_tree() -> void:
	_discard_drink()
"

