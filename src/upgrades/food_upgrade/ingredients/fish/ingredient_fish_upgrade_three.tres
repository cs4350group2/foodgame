[gd_resource type="Resource" script_class="EarningUpgrade" load_steps=5 format=3]

[ext_resource type="Script" path="res://src/upgrades/food_upgrade/earning_params.gd" id="1_params"]
[ext_resource type="Script" path="res://src/upgrades/food_upgrade/earning_upgrade.gd" id="2_upgrade"]

[sub_resource type="Resource" id="Resource_effect_0"]
script = ExtResource("1_params")
food = &"Grilled Fish"
multiplier = 1.05
overwrite_existing_value = false

[sub_resource type="Resource" id="Resource_effect_1"]
script = ExtResource("1_params")
food = &"Sushi"
multiplier = 1.05
overwrite_existing_value = false

[resource]
script = ExtResource("2_upgrade")
effects = Array[ExtResource("1_params")]([SubResource("Resource_effect_0"), SubResource("Resource_effect_1")])
name = &"ingredient_fish_upgrade_three"
display_name = &"Premium Fish III"
description = "Increase base payouts of meals containing fish by another 5%, regardless of preparation: Grilled Fish, Sushi. Stacks multiplicatively with other earnings upgrades."
dependencies = Array[StringName]([&"ingredient_fish_upgrade_two"])
price = 150.0
